# Copy this file to .env and fill in your own credentials.
# .env is ignored by Git. Never commit a real API key.

AGENTVAST_SEMANTIC_API_BASE_URL=https://provider.example
AGENTVAST_SEMANTIC_API_KEY=replace-with-a-new-key
AGENTVAST_SEMANTIC_MODEL=gpt-6.1-sol
AGENTVAST_SEMANTIC_REASONING_EFFORT=medium

# Optional: reuse ANTHROPIC_BASE_URL and ANTHROPIC_API_KEY from
# ~/.claude/settings.json instead of duplicating credentials above.
# AGENTVAST_SEMANTIC_USE_CLAUDE_SETTINGS=true

# Optional request behavior
AGENTVAST_SEMANTIC_TIMEOUT=180
AGENTVAST_SEMANTIC_MAX_RETRIES=5
AGENTVAST_SEMANTIC_RESPONSE_FORMAT=true
# auto tries strict schema first; use json_object for gateways known to reject it.
AGENTVAST_SEMANTIC_RESPONSE_MODE=auto
AGENTVAST_SEMANTIC_RETRY_BASE_SECONDS=5
AGENTVAST_SEMANTIC_RETRY_MAX_SECONDS=60
AGENTVAST_SEMANTIC_RETRY_JITTER_SECONDS=3
AGENTVAST_SEMANTIC_REQUEST_INTERVAL_SECONDS=2
# Independent Episode annotations run concurrently (1-8).
AGENTVAST_SEMANTIC_CONCURRENCY=4
# Event annotations are independent within each batch; global stages retain all summaries.
AGENTVAST_EVENT_BATCH_SIZE=6
AGENTVAST_EVENT_GLOBAL_MAX_CHARS=220000

# If a local proxy is configured but this API should connect directly:
# NO_PROXY=provider.example
